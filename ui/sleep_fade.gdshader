shader_type canvas_item;

// 睡眠视野过渡的「变暗」部分（2026-09-22）。
//
// 挂在 `main.tscn` 的 `UI/SleepFade`（一个铺满整屏的 ColorRect）上，
// 由 `ui/sleep_fade.gd` 把 `t` 喂进来。**本 shader 不做任何决策，只画。**
//
// ══════════════════════════════════════════════════════════════════
// 一、为什么是「竖向压扁的椭圆」而不是正圆暗角
// ══════════════════════════════════════════════════════════════════
//   真实的闭眼是**上下眼皮合拢**（垂直方向收窄），不是从四角往中间收的圆。
//   所以这里把 y 乘 `1.35` 再取长度 —— 同样的距离下，**上下方向更早到阈值**，
//   于是"上下先暗、左右后暗"，读起来像眼皮在合。
//   （想更像"光圈收拢"就把 `1.35` 改成 `1.0`。）
//
// ══════════════════════════════════════════════════════════════════
// 二、为什么用 `UV` 而不是 `SCREEN_UV`
// ══════════════════════════════════════════════════════════════════
//   本节点是铺满整屏的 ColorRect，`UV` 本身就是屏幕坐标。
//   用 `SCREEN_UV` 需要 `BackBufferCopy` 才能拿到屏幕纹理 —— 那是多余的一层开销，
//   而且会引入渲染顺序问题。**不需要屏幕内容，只需要画一层遮罩，所以 `UV` 就够。**

uniform float t : hint_range(0.0, 1.0) = 0.0;
// 画面**中心**额外压暗（用户要的"微微变暗"）。
uniform float darken_center : hint_range(0.0, 1.0) = 0.10;
// 画面**边缘**额外压暗（叠在中心之上）—— 暗角本体。
uniform float darken_edge : hint_range(0.0, 1.0) = 0.34;
// 色偏。**刻意不是纯黑**：夜里 `NightOverlay` 已经叠了一层黑，
// 再叠纯黑会糊成一团；偏冷蓝紫读起来像"沉下去"而不是"停电了"。
uniform vec4 tint : source_color = vec4(0.03, 0.02, 0.06, 1.0);

void fragment() {
	// 以屏幕中心为原点；y 方向拉长 ⇒ 上下先暗（像眼皮合拢，见文件头第一节）
	vec2 p = (UV - vec2(0.5)) * vec2(1.0, 1.35);
	float d = length(p);
	// 0.26 以内完全不受影响（保留中心可读区），0.62 以外吃满暗角
	float edge = smoothstep(0.26, 0.62, d);
	float a = t * (darken_center + edge * darken_edge);
	// 上限 0.92：留一点缝，避免"全黑"（与"把夜晚当后台"的路线冲突 —— 全黑就看不见世界了）
	COLOR = vec4(tint.rgb, clamp(a, 0.0, 0.92));
}
