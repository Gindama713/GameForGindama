[gd_resource type="Resource" script_class="SkillCatalog" load_steps=15 format=3]

[ext_resource type="Script" path="res://creature/skills/skill_catalog.gd" id="1"]
[ext_resource type="Script" path="res://creature/skills/skill_def.gd" id="2"]

[sub_resource type="Resource" id="Running"]
script = ExtResource("2")
id = &"running"
display_name = "跑步"
primary_attribute = &"physique"
secondary_attribute = &"dexterity"
experience_per_effort = 0.25

