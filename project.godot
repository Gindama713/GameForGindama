; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="IsleSurvival"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

WorldSeed="*res://common/world_seed.gd"
GridManager="*res://common/grid/grid_manager.gd"
TimeSystem="*res://common/time_system.gd"
EventBus="*res://common/event_bus.gd"
Log="*res://common/log.gd"
DefValidator="*res://common/def_validator.gd"
GrassField="*res://world/grass/grass_field.gd"
FamilyRegistry="*res://common/family_registry.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=768
window/size/borderless=true
window/size/window_width_override=1280
window/size/window_height_override=768
; —— 全屏自适应（问题1 修复，2026-09-20）——
; stretch/mode = canvas_items：整个 Canvas 层（世界 + CanvasLayer UI）一起缩放 → UI 与画面不脱节。
; stretch/aspect = keep：**保持 1280:768 的宽高比**，多余方向留黑边，**绝不拉伸变形**。
;   ⚠ 关键点：原配置**缺 aspect 行** → 默认是 "ignore"，窗口一变比例就整体拉伸（人变胖、格子变扁）。
;   另外 window/stretch/scale_mode 保持默认 "fractional"（字与线稿不糊），
;   像素字体靠 import 关掉抗锯齿 + 整数倍字号保证不糊（见 §2.4）。
; 允许 F11 / Alt+Enter 切全屏（Godot 内置），也允许用户直接拉伸窗口。
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

theme/custom="res://ui/game_theme.tres"

[input]

; —— 主角移动（2026-09-20）——
; 项目首次使用 InputMap。原先相机平移硬编码 KEY_W/A/S/D + 方向键（camera_rig.gd）；
; 主角出现后 WASD 归玩家，相机只在"没有跟随目标"时才吃键盘（见 camera_rig.gd 软跟随）。
; 4 向网格（GridMover.DIRS = 上下左右），故 4 个 action 各绑 2 个物理键。
; ⚠ 用 physical_keycode 而不是 keycode：与键盘布局无关（AZERTY 用户按同一个物理键也对得上）。
move_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":87,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194320,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
