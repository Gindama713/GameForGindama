; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="IsleSurvival"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
run/main_scene="res://main.tscn"

[display]

; 视口基准 = 整个网格：40 x 24 格 x 32px = 1280 x 768（正好一屏装下逻辑网格）
window/size/viewport_width=1280
window/size/viewport_height=768
; 初始窗口 = 视口 1:1（最清晰）；玩家拉大窗口后靠 below 的 stretch 自动放大
window/size/window_width_override=1280
window/size/window_height_override=768
; canvas_items：整个 2D（含 Control UI）一起缩放，画面随窗口变大而变大
window/stretch/mode="canvas_items"
; keep：等比缩放 + 多余区域留黑（背景本就是纯黑，看不出黑边）；不会拉伸变形
window/stretch/aspect="keep"
window/stretch/scale_mode="fractional"

[gui]

theme/custom="res://ui/game_theme.tres"

[physics]

3d/physics_engine="Jolt Physics"

[autoload]

GridManager="*res://grid_manager.gd"
TimeSystem="*res://time_system.gd"
EventBus="*res://event_bus.gd"
Log="*res://log.gd"
DefValidator="*res://def_validator.gd"

[rendering]

environment/defaults/default_clear_color=Color(0, 0, 0, 1)
rendering_device/driver.windows="d3d12"
